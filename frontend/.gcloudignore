# Files NOT uploaded when the dashboard is deployed to Cloud Run with `gcloud run deploy --source .`
# Google Cloud installs the libraries and builds the app itself, so these local folders aren't needed.
.gcloudignore
.git
.gitignore
node_modules/
.next/
out/
build/
coverage/
.env*
*.log
*.tsbuildinfo
next-env.d.ts
.vercel/
